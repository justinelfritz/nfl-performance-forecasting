.streamlit/secrets.toml

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs / temp ----
*.log
*.tmp

# ---- Project data ----
# data/ holds ESPN caches (games_*.csv, box_*.csv) and model outputs. They are small (~2 MB)
# and slow to re-scrape, so they are tracked by default. To keep only the tuned model
# parameters in git and re-download everything else, uncomment these lines:
# data/*
# !data/model_params.json
